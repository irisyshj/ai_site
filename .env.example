# AI Chat Configuration
# Configure your Dify or Coze chatbot integration

# The URL of your AI chat embed (Dify/Coze)
# Example: https://your-bot.dify.ai/chatbot
# Leave empty to use the default demo URL
NEXT_PUBLIC_AI_CHAT_URL=

# Enable or disable the AI chat widget globally
# Set to 'false' to hide the floating widget on all pages
# Default: true
NEXT_PUBLIC_AI_CHAT_ENABLED=true
